generator client {
  provider      = "prisma-client-js"
  output        = "./src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(50)
  description String?   @db.Text
  created_at  DateTime  @default(now())
  products    Product[]
}

model Customer {
  id          Int       @id @default(autoincrement())
  full_name   String
  email       String    @unique
  password    String    @db.VarChar(255)
  phone       String?   @unique @db.VarChar(20)
  address     String?   @db.Text
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt
  facebook_id String?   @unique
  google_id   String?   @unique
  fcm_token   String?
  orders      Order[]
}

model Order {
  id                     Int             @id @default(autoincrement())
  order_number           String          @unique @db.VarChar(20)
  customer_id            Int
  order_date             DateTime        @default(now())
  total_amount           Decimal         @db.Decimal(12, 2)
  status                 Order_Status    @default(pending)
  shipping_address       String          @db.Text
  phone                  String          @db.VarChar(20)
  notes                  String?         @db.Text
  created_at             DateTime        @default(now())
  expected_delivery_date DateTime?
  paid_at                DateTime?
  payment_method         Payment_Method  @default(cash_on_delivery)
  payment_status         Payment_Status  @default(pending)
  shipping_fee           Decimal         @default(0.00) @db.Decimal(10, 2)
  shipping_method        Shipping_Method @default(standard_delivery)
  updated_at             DateTime?       @updatedAt
  gateway                String?         @db.VarChar(50)
  paid_amount            Decimal?        @db.Decimal(12, 2)
  payment_verified_at    DateTime?
  transaction_code       String?         @db.VarChar(50)
  transaction_content    String?         @db.Text
  transaction_id         String?         @unique @db.VarChar(50)
  customer               Customer        @relation(fields: [customer_id], references: [id])
  order_details          OrderDetail[]

  @@index([transaction_id])
  @@index([payment_status])
  @@index([order_number])
  @@index([customer_id], map: "Order_customer_id_fkey")
}

model OrderDetail {
  id          Int     @id @default(autoincrement())
  order_id    Int
  product_id  Int
  quantity    Int
  unit_price  Decimal @db.Decimal(12, 2)
  total_price Decimal @db.Decimal(12, 2)
  order       Order   @relation(fields: [order_id], references: [id])
  product     Product @relation(fields: [product_id], references: [id])

  @@unique([order_id, product_id])
  @@index([product_id], map: "OrderDetail_product_id_fkey")
}

model Product_Image {
  id         Int     @id @default(autoincrement())
  product_id Int
  url        String  @db.VarChar(500)
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id], map: "Product_Image_product_id_fkey")
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  description    String?         @db.Text
  price          Decimal         @db.Decimal(12, 2)
  sale_price     Decimal?        @db.Decimal(12, 2)
  category_id    Int
  stock_quantity Int             @default(0)
  material       String?         @db.VarChar(500)
  color          String?         @db.VarChar(50)
  status         Product_Status  @default(active)
  created_at     DateTime        @default(now())
  updated_at     DateTime?       @updatedAt
  height         Decimal?        @db.Decimal(10, 2)
  length         Decimal?        @db.Decimal(10, 2)
  weight         Decimal?        @db.Decimal(10, 2)
  width          Decimal?        @db.Decimal(10, 2)
  brand          String?         @db.VarChar(100)
  discount       Int?
  rating         Float?
  reviews        Int?
  shipping       String?         @db.VarChar(100)
  style          String?         @db.VarChar(100)
  warranty       String?         @db.VarChar(100)
  order_details  OrderDetail[]
  category       Category        @relation(fields: [category_id], references: [id])
  images         Product_Image[]
  tags           Tag[]           @relation("ProductToTag")

  @@index([category_id], map: "Product_category_id_fkey")
}

model Admin {
  id          Int      @id @default(autoincrement())
  username    String   @unique @db.VarChar(50)
  password    String   @db.VarChar(255)
  full_name   String   @db.VarChar(100)
  email       String   @unique @db.VarChar(100)
  created_at  DateTime @default(now())
  facebook_id String?  @unique
  google_id   String?  @unique
}

model Tag {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(50)
  products Product[] @relation("ProductToTag")
}

model AiSearchHistory {
  id                 Int        @id @default(autoincrement())
  session_id         String     @unique(map: "session_id") @db.VarChar(36)
  user_id            Int?
  anonymous_id       String?    @db.VarChar(255)
  query_type         Query_Type
  platform           String?    @db.VarChar(50)
  source_feature     String?    @db.VarChar(100)
  original_image_url String?    @db.Text
  detected_objects   Json?
  selected_bbox      Json?
  recommendations    Json?
  created_at         DateTime?  @default(now()) @db.Timestamp(0)
  updated_at         DateTime?  @default(now()) @updatedAt @db.Timestamp(0)

  @@index([anonymous_id], map: "idx_anonymous_id")
  @@index([created_at], map: "idx_created_at")
  @@index([session_id], map: "idx_session_id")
  @@index([user_id], map: "idx_user_id")
  @@map("ai_search_history")
}

enum Order_Status {
  pending
  confirmed
  shipping
  completed
  cancelled
}

enum Payment_Method {
  cash_on_delivery
  bank_transfer
  credit_card
  e_wallet
  installment
}

enum Payment_Status {
  pending
  paid
  failed
  refunded
}

enum Shipping_Method {
  standard_delivery
  express_delivery
  same_day_delivery
  pickup_at_store
  installation_service
}

enum Product_Status {
  active
  inactive
}

enum Query_Type {
  detect
  recommend
}
