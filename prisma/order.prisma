enum Order_Status{
    pending
    confirmed
    shipping
    completed
    cancelled
}

enum Payment_Method {
  cash_on_delivery  
  bank_transfer     
  credit_card       
  e_wallet         
  installment      
}

enum Payment_Status {
  pending
  paid
  failed
  refunded
}

enum Shipping_Method {
  standard_delivery
  express_delivery 
  same_day_delivery
  pickup_at_store     
  installation_service 
}

model Order {
  id                    Int            @id @default(autoincrement())
  order_number          String         @unique @db.VarChar(20)
  customer_id           Int
  order_date            DateTime       @default(now())
  total_amount          Decimal        @db.Decimal(12, 2)
  shipping_fee          Decimal        @db.Decimal(10, 2) @default(0)
  
  status                Order_Status    @default(pending)
  
  payment_method        Payment_Method  @default(cash_on_delivery)
  payment_status        Payment_Status  @default(pending)
  paid_at               DateTime?      
   
  shipping_method       Shipping_Method @default(standard_delivery)
  shipping_address      String         @db.Text
  phone                 String         @db.VarChar(20)
  expected_delivery_date DateTime?  
  
  notes                 String?        @db.Text
  created_at            DateTime       @default(now())
  updated_at            DateTime?       @updatedAt
  
  customer              Customer       @relation(fields: [customer_id], references: [id])
  order_details         OrderDetail[]
}

model OrderDetail{
    id Int @id @default(autoincrement())
    order_id Int 
    product_id Int
    quantity Int
    unit_price Decimal @db.Decimal(10, 2)
    total_price Decimal @db.Decimal(10, 2)

    order Order @relation(fields: [order_id], references: [id])
    product Product @relation(fields: [product_id], references: [id])

    @@unique([order_id, product_id])
}